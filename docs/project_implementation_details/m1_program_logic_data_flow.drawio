<mxfile host="Electron" agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) draw.io/29.3.0 Chrome/140.0.7339.249 Electron/38.7.2 Safari/537.36" version="29.3.0" pages="3">
  <diagram id="m1-clean-main" name="M1 主链路-清晰版">
    <mxGraphModel dx="1811" dy="873" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1" value="M1 Demand Planning 重构后主链路（以 demand_planning_refactor 为准）" vertex="1">
          <mxGeometry height="40" width="760" x="40" y="20" as="geometry" />
        </mxCell>
        <mxCell id="legend" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=left;spacing=8" value="蓝色：函数处理节点&lt;br&gt;绿色：输入/状态读取&lt;br&gt;橙色：中间或最终数据对象&lt;br&gt;红色：状态更新/下游消费" vertex="1">
          <mxGeometry height="100" width="300" x="1340" as="geometry" />
        </mxCell>
        <mxCell id="lane_cfg" parent="1" style="swimlane;html=1;startSize=30;horizontal=1;rounded=0;fillColor=#eef7ee;strokeColor=#82b366;fontStyle=1" value="配置与预测准备" vertex="1">
          <mxGeometry height="210" width="1580" x="40" y="100" as="geometry" />
        </mxCell>
        <mxCell id="cfg" parent="lane_cfg" style="shape=cylinder3d;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12" value="M1 配置输入&lt;br&gt;DemandForecast / ForecastError / OrderCalendar / AOConfig / DPSConfig / SupplyChoiceConfig" vertex="1">
          <mxGeometry height="100" width="260" x="30" y="65" as="geometry" />
        </mxCell>
        <mxCell id="entry" parent="lane_cfg" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1" value="run_daily_order_generation()" vertex="1">
          <mxGeometry height="70" width="230" x="350" y="80" as="geometry" />
        </mxCell>
        <mxCell id="validate" parent="lane_cfg" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12" value="_validate_config()&lt;br&gt;必填表检查 / 日期转换 / 负需求裁零 / 标识符标准化" vertex="1">
          <mxGeometry height="90" width="260" x="650" y="70" as="geometry" />
        </mxCell>
        <mxCell id="prepare" parent="lane_cfg" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12" value="_prepare_forecasts()&lt;br&gt;DPS 后保留 weekly_for_orders&lt;br&gt;拆出 daily_for_consumption&lt;br&gt;DPS + SupplyChoice 后拆出 daily_for_supply" vertex="1">
          <mxGeometry height="90" width="260" x="990" y="70" as="geometry" />
        </mxCell>
        <mxCell id="daily_views" parent="lane_cfg" style="shape=cylinder3d;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12" value="weekly_for_orders&lt;br&gt;daily_for_consumption&lt;br&gt;daily_for_supply" vertex="1">
          <mxGeometry height="70" width="210" x="1320" y="80" as="geometry" />
        </mxCell>
        <mxCell id="lane_order" parent="1" style="swimlane;html=1;startSize=30;horizontal=1;rounded=0;fillColor=#f7fbff;strokeColor=#6c8ebf;fontStyle=1" value="订单生成与历史订单合并" vertex="1">
          <mxGeometry height="220" width="1580" x="42" y="340" as="geometry" />
        </mxCell>
        <mxCell id="gen_order" parent="lane_order" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12" value="generate_daily_orders()&lt;br&gt;周级输入：generate_weekly_orders()&lt;br&gt;再 split_weekly_orders_to_daily()&lt;br&gt;日级输入：保留旧兼容路径&lt;br&gt;内部返回 consumed_forecast" vertex="1">
          <mxGeometry height="95" width="300" x="60" y="80" as="geometry" />
        </mxCell>
        <mxCell id="today_orders" parent="lane_order" style="shape=cylinder3d;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12" value="today_orders_df&lt;br&gt;当日新增订单&lt;br&gt;date = require_date&lt;br&gt;simulation_date = order_date" vertex="1">
          <mxGeometry height="70" width="190" x="440" y="90" as="geometry" />
        </mxCell>
        <mxCell id="history" parent="lane_order" style="shape=cylinder3d;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12" value="历史订单来源&lt;br&gt;DB: previous_orders_df&lt;br&gt;文件: load_previous_orders()" vertex="1">
          <mxGeometry height="95" width="220" x="710" y="80" as="geometry" />
        </mxCell>
        <mxCell id="merge" parent="lane_order" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12" value="_merge_with_history()&lt;br&gt;历史订单 + 当日订单&lt;br&gt;过滤 date &gt;= simulation_date&lt;br&gt;去重 / 标准化" vertex="1">
          <mxGeometry height="95" width="260" x="1010" y="80" as="geometry" />
        </mxCell>
        <mxCell id="all_orders" parent="lane_order" style="shape=cylinder3d;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12" value="all_orders_df / orders_df&lt;br&gt;累计订单池" vertex="1">
          <mxGeometry height="70" width="190" x="1360" y="90" as="geometry" />
