        <mxCell id="lane_outputs" parent="1" style="swimlane;html=1;startSize=30;horizontal=1;rounded=0;fillColor=#fff9ef;strokeColor=#d6b656;fontStyle=1" value="发货、供需日志、输出与状态更新" vertex="1">
          <mxGeometry height="310" width="1580" x="40" y="600" as="geometry" />
