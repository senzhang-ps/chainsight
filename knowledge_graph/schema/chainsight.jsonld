    },

    {
      "@id": "cs:MaterialValuation",
      "@type": "owl:Class",
      "subClassOf": "cs:Product",
      "label": "MaterialValuation",
      "altLabel": ["物料估价", "valuation", "成本"],
      "comment": "Material valuation data — standard price, moving average price, price unit. Used for cost-related KPI computation.",
