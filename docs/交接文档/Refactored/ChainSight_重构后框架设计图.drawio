<mxCell id="f2" value="&lt;b&gt;2. 断点续跑检查&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;check_resume_capability(output_dir, start, end)&lt;br&gt;检测已完成日期 → actual_start_date&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontSize=11;arcSize=10;shadow=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="490" y="210" width="280" height="70" as="geometry"/></mxCell>
<mxCell id="f3" value="&lt;b&gt;3. 创建 Orchestrator&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;create_orchestrator(start_date, output_dir)&lt;br&gt;初始化中央状态枢纽&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;fontSize=11;arcSize=10;shadow=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="490" y="300" width="280" height="65" as="geometry"/></mxCell>
<mxCell id="f4" value="&lt;b&gt;4. 初始化时间管理器&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;SimulationTimeManager(start_date)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontSize=11;arcSize=10;shadow=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="490" y="385" width="280" height="50" as="geometry"/></mxCell>
<mxCell id="f5" value="&lt;b&gt;5. 加载配置&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;load_configuration(config_path)&lt;br&gt;Excel → config_dict (20+ DataFrames)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#7B1FA2;fontSize=11;arcSize=10;shadow=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="490" y="455" width="280" height="65" as="geometry"/></mxCell>
<mxCell id="f6" value="&lt;b&gt;6. 设置随机种子&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;set_module_seeds(config_dict) → 可复现性&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontSize=11;arcSize=10;shadow=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="490" y="540" width="280" height="50" as="geometry"/></mxCell>
<mxCell id="fls" value="&lt;b&gt;每日循环开始&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;for date in [actual_start, end_date]&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#0D47A1;fontSize=12;arcSize=10;shadow=1;fontStyle=1;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="470" y="620" width="320" height="50" as="geometry"/></mxCell>
<mxCell id="fm1" value="&lt;b&gt;7a. M1 需求规划&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;run_daily_order_generation(config_dict, date,&lt;br&gt;  output_dir, orchestrator)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#2E7D32;fontSize=11;arcSize=10;shadow=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="470" y="700" width="320" height="65" as="geometry"/></mxCell>
<mxCell id="fm1o" value="&lt;font style=&#x27;font-size:8px&#x27;&gt;→ orders_df&lt;br&gt;→ shipment_df&lt;br&gt;→ cut_df (缺料)&lt;br&gt;→ supply_demand_log_df&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontSize=8;arcSize=10;shadow=0;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1250" y="695" width="200" height="65" as="geometry"/></mxCell>
<mxCell id="fm1n" value="&lt;font style=&#x27;font-size:8px&#x27;&gt;&lt;b&gt;输入：&lt;/b&gt;&lt;br&gt;• config_dict[M1_*]&lt;br&gt;• orchestrator.unrestricted_inventory&lt;br&gt;• previous_orders_df&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#F57F17;fontSize=9;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;shadow=0;size=14;" vertex="1" parent="1"><mxGeometry x="60" y="695" width="200" height="70" as="geometry"/></mxCell>
<mxCell id="fm3" value="&lt;b&gt;7b. M3 MRP 计划&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;run_integrated_mode(m1_dir, orchestrator,&lt;br&gt;  config_dict, start, end, output_dir, m1_result)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#A5D6A7;strokeColor=#1B5E20;fontSize=11;arcSize=10;shadow=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="470" y="795" width="320" height="65" as="geometry"/></mxCell>
<mxCell id="fm3o" value="&lt;font style=&#x27;font-size:8px&#x27;&gt;→ net_demand_df&lt;br&gt;→ consolidated_demand_df&lt;br&gt;→ safety_demand_df&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#1B5E20;fontSize=8;arcSize=10;shadow=0;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1250" y="795" width="200" height="55" as="geometry"/></mxCell>
<mxCell id="fm3n" value="&lt;font style=&#x27;font-size:8px&#x27;&gt;&lt;b&gt;输入：&lt;/b&gt;&lt;br&gt;• M1 orders/shipment&lt;br&gt;• orchestrator: open_deployment,&lt;br&gt;  in_transit, delivery_gr,&lt;br&gt;  production_plan_backlog&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#F57F17;fontSize=9;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;shadow=0;size=14;" vertex="1" parent="1"><mxGeometry x="60" y="790" width="200" height="80" as="geometry"/></mxCell>
<mxCell id="fm4" value="&lt;b&gt;7c. M4 生产计划&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;run_module4_integrated(config_dict, date,&lt;br&gt;  output_dir, m3_result, runtime_state)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#81C784;strokeColor=#33691E;fontSize=11;arcSize=10;shadow=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="470" y="890" width="320" height="65" as="geometry"/></mxCell>
<mxCell id="fm4o" value="&lt;font style=&#x27;font-size:8px&#x27;&gt;→ production_df&lt;br&gt;→ exceed_log&lt;br&gt;→ changeover_log&lt;br&gt;→ line_states / capacity&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#33691E;fontSize=8;arcSize=10;shadow=0;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1250" y="885" width="200" height="65" as="geometry"/></mxCell>
<mxCell id="fm4n" value="&lt;font style=&#x27;font-size:8px&#x27;&gt;&lt;b&gt;输入：&lt;/b&gt;&lt;br&gt;• M3 net_demand_df&lt;br&gt;• line_states (前日)&lt;br&gt;• allocated_capacity (累积)&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#F57F17;fontSize=9;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;shadow=0;size=14;" vertex="1" parent="1"><mxGeometry x="60" y="890" width="200" height="65" as="geometry"/></mxCell>
<mxCell id="fm5" value="&lt;b&gt;7d. M5 调拨规划&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;main(config, m1_dir, m4_dir, orchestrator,&lt;br&gt;  sim_date, output_dir)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCEDC8;strokeColor=#558B2F;fontSize=11;arcSize=10;shadow=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="470" y="985" width="320" height="65" as="geometry"/></mxCell>
<mxCell id="fm5o" value="&lt;font style=&#x27;font-size:8px&#x27;&gt;→ deployment_df&lt;br&gt;→ validation_log&lt;br&gt;→ allocation_detail&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#558B2F;fontSize=8;arcSize=10;shadow=0;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1250" y="985" width="200" height="55" as="geometry"/></mxCell>
<mxCell id="fm5n" value="&lt;font style=&#x27;font-size:8px&#x27;&gt;&lt;b&gt;输入：&lt;/b&gt;&lt;br&gt;• M1 shipment/orders&lt;br&gt;• M4 production&lt;br&gt;• orchestrator: inventory,&lt;br&gt;  open_deployment, in_transit,&lt;br&gt;  production_gr, delivery_gr&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#F57F17;fontSize=9;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;shadow=0;size=14;" vertex="1" parent="1"><mxGeometry x="60" y="980" width="200" height="85" as="geometry"/></mxCell>
<mxCell id="fm6" value="&lt;b&gt;7e. M6 物流执行&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;run_daily_physical_flow(config_dict,&lt;br&gt;  orchestrator, date, output_dir)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F4C3;strokeColor=#827717;fontSize=11;arcSize=10;shadow=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="470" y="1080" width="320" height="65" as="geometry"/></mxCell>
<mxCell id="fm6o" value="&lt;font style=&#x27;font-size:8px&#x27;&gt;→ truck_load_df&lt;br&gt;→ delivery_df&lt;br&gt;→ physical_inventory_df&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#827717;fontSize=8;arcSize=10;shadow=0;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1250" y="1080" width="200" height="55" as="geometry"/></mxCell>
<mxCell id="fm6n" value="&lt;font style=&#x27;font-size:8px&#x27;&gt;&lt;b&gt;输入：&lt;/b&gt;&lt;br&gt;• M5 deployment_df&lt;br&gt;• orchestrator: inventory,&lt;br&gt;  open_deployment&lt;br&gt;• config: truck specs, MDQ&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#F57F17;fontSize=9;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;shadow=0;size=14;" vertex="1" parent="1"><mxGeometry x="60" y="1075" width="200" height="80" as="geometry"/></mxCell>
<mxCell id="fop" value="&lt;b&gt;8. Orchestrator 状态更新&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;run_daily_processing(date, shipment_df,&lt;br&gt;  production_df, deployment_df, delivery_df)&lt;br&gt;按序: M1发货→M4生产→M5调拨→M6交付&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBE9E7;strokeColor=#D84315;fontSize=11;arcSize=10;shadow=1;fontStyle=1;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="470" y="1175" width="320" height="80" as="geometry"/></mxCell>
<mxCell id="fopn" value="&lt;font style=&#x27;font-size:8px&#x27;&gt;&lt;b&gt;处理顺序：&lt;/b&gt;&lt;br&gt;① process_module1_shipments&lt;br&gt;② process_module4_production&lt;br&gt;③ process_module5_deployment&lt;br&gt;④ process_module6_delivery&lt;br&gt;⑤ cleanup_past_due()&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;fillColor=#FBE9E7;strokeColor=#D84315;fontSize=9;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;shadow=0;size=14;" vertex="1" parent="1"><mxGeometry x="1250" y="1170" width="220" height="95" as="geometry"/></mxCell>
