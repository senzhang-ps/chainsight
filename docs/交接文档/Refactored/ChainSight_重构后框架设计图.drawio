  <!-- ========== 第2页：每日仿真执行流程 ========== -->
  <diagram id="page2-daily-flow" name="每日仿真执行流程">
    <mxGraphModel dx="1600" dy="1600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1600" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ===== 标题 ===== -->
        <mxCell id="p2_title" value="ChainSight v2.0 每日仿真执行流程" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=22;fontStyle=1;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="60" y="15" width="600" height="36" as="geometry" />
        </mxCell>
        <mxCell id="p2_sub" value="单日循环: 日初处理 → M1 → M4 → M5 → M6 → M3 → 日末保存 → 下一天" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#888888;" vertex="1" parent="1">
          <mxGeometry x="60" y="48" width="800" height="20" as="geometry" />
        </mxCell>

        <!-- ===== 左侧：Orchestrator 状态列 ===== -->
        <mxCell id="orch_col" value="&lt;b&gt;Orchestrator 状态 (SSOT)&lt;/b&gt;" style="swimlane;startSize=24;fillColor=#fce4e4;strokeColor=#b85450;rounded=1;fontSize=11;fontStyle=1;swimlaneLine=0;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="85" width="280" height="1480" as="geometry" />
        </mxCell>
        <mxCell id="os1" value="&lt;font style=&quot;font-size:10px&quot;&gt;📦 unrestricted_inventory&lt;br&gt;非限制库存（按 ML 粒度）&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#b85450;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="orch_col">
          <mxGeometry x="10" y="35" width="260" height="40" as="geometry" />
        </mxCell>
        <mxCell id="os2" value="&lt;font style=&quot;font-size:10px&quot;&gt;📋 open_deployment&lt;br&gt;待执行调拨（M5 生成，M6 消费）&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#b85450;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="orch_col">
          <mxGeometry x="10" y="85" width="260" height="40" as="geometry" />
        </mxCell>
        <mxCell id="os3" value="&lt;font style=&quot;font-size:10px&quot;&gt;🚚 planning_intransit&lt;br&gt;在途货物（M6 发运 → 未来到货）&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#b85450;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="orch_col">
          <mxGeometry x="10" y="135" width="260" height="40" as="geometry" />
        </mxCell>
        <mxCell id="os4" value="&lt;font style=&quot;font-size:10px&quot;&gt;🏭 production_gr&lt;br&gt;生产入库记录&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#b85450;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="orch_col">
          <mxGeometry x="10" y="185" width="260" height="36" as="geometry" />
        </mxCell>
        <mxCell id="os5" value="&lt;font style=&quot;font-size:10px&quot;&gt;📥 delivery_gr&lt;br&gt;交付入库记录&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#b85450;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="orch_col">
          <mxGeometry x="10" y="230" width="260" height="36" as="geometry" />
        </mxCell>
        <mxCell id="os6" value="&lt;font style=&quot;font-size:10px&quot;&gt;📊 shipment_log / space_quota&lt;br&gt;发货日志 / 接收空间配额&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#b85450;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="orch_col">
          <mxGeometry x="10" y="275" width="260" height="36" as="geometry" />
        </mxCell>
        <mxCell id="os_snap" value="&lt;font style=&quot;font-size:10px&quot;&gt;💾 save_daily_state(date) → CSV&lt;br&gt;每日快照 → 支持断点续跑&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="orch_col">
          <mxGeometry x="10" y="330" width="260" height="40" as="geometry" />
        </mxCell>

        <!-- ===== 中间：主执行流程 ===== -->
        <mxCell id="flow_col" value="&lt;b&gt;主执行流程 (main_integration)&lt;/b&gt;" style="swimlane;startSize=24;fillColor=#d5e8d4;strokeColor=#82b366;rounded=1;fontSize=11;fontStyle=1;swimlaneLine=0;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="380" y="85" width="520" height="1480" as="geometry" />
        </mxCell>

        <!-- Start -->
        <mxCell id="f_start" value="&lt;b&gt;开始仿真&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;加载配置 → 初始化 Orchestrator&lt;br&gt;→ 检查续跑 → 设置随机种子&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;shadow=1;" vertex="1" parent="flow_col">
          <mxGeometry x="100" y="40" width="320" height="60" as="geometry" />
        </mxCell>

        <!-- Day Loop Start -->
        <mxCell id="f_dayloop" value="&lt;b&gt;📅 按日仿真循环&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;for date in simulation_dates&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;shadow=1;" vertex="1" parent="flow_col">
          <mxGeometry x="100" y="125" width="320" height="45" as="geometry" />
        </mxCell>

        <!-- Step 0: 日初 -->
        <mxCell id="f_dayinit" value="&lt;b&gt;Step 0: 日初处理&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;save_beginning_inventory(date)&lt;br&gt;cleanup_past_due_open_deployments(date)&lt;br&gt;_process_delivery_arrivals(date) — 在途到货入库&lt;br&gt;load_current_date_production_gr() — 当日生产入库&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#82b366;fontSize=11;shadow=1;align=left;spacingLeft=10;" vertex="1" parent="flow_col">
          <mxGeometry x="60" y="200" width="400" height="85" as="geometry" />
        </mxCell>

        <!-- M1 -->
        <mxCell id="f_m1" value="&lt;b&gt;① M1: demand_planning&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;run_daily_order_generation(...)&lt;br&gt;→ process_module1_shipments(shipment_df)&lt;br&gt;🔸 扣减发货库存&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8daf0;strokeColor=#9673a6;fontSize=11;shadow=1;align=left;spacingLeft=10;" vertex="1" parent="flow_col">
          <mxGeometry x="60" y="315" width="400" height="72" as="geometry" />
        </mxCell>

        <!-- M4 -->
        <mxCell id="f_m4" value="&lt;b&gt;② M4: production_planning&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;run_module4_integrated(...)&lt;br&gt;→ process_module4_production(production_df)&lt;br&gt;🔸 持久化未来生产计划&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8daf0;strokeColor=#9673a6;fontSize=11;shadow=1;align=left;spacingLeft=10;" vertex="1" parent="flow_col">
          <mxGeometry x="60" y="417" width="400" height="72" as="geometry" />
        </mxCell>

        <!-- M5 -->
        <mxCell id="f_m5" value="&lt;b&gt;③ M5: deployment_planning&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;module5.main(...)&lt;br&gt;→ process_module5_deployment(deployment_plan)&lt;br&gt;🔸 新增 open_deployment&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8daf0;strokeColor=#9673a6;fontSize=11;shadow=1;align=left;spacingLeft=10;" vertex="1" parent="flow_col">
          <mxGeometry x="60" y="519" width="400" height="72" as="geometry" />
        </mxCell>

        <!-- M6 -->
        <mxCell id="f_m6" value="&lt;b&gt;④ M6: logistics_execution&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;run_daily_physical_flow(...)&lt;br&gt;→ process_module6_delivery(delivery_plan)&lt;br&gt;🔸 扣库存 + 关闭 open_deployment + 新增 in-transit&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8daf0;strokeColor=#9673a6;fontSize=11;shadow=1;align=left;spacingLeft=10;" vertex="1" parent="flow_col">
          <mxGeometry x="60" y="621" width="400" height="78" as="geometry" />
        </mxCell>

        <!-- M3 -->
        <mxCell id="f_m3" value="&lt;b&gt;⑤ M3: mrp_planning&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;run_integrated_mode(...)&lt;br&gt;→ 输出 net_demand_df&lt;br&gt;🔸 layer=0 净需求 → 下一天 M4 输入&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8daf0;strokeColor=#9673a6;fontSize=11;shadow=1;align=left;spacingLeft=10;" vertex="1" parent="flow_col">
          <mxGeometry x="60" y="729" width="400" height="72" as="geometry" />
        </mxCell>

        <!-- Step End: 日末 -->
        <mxCell id="f_dayend" value="&lt;b&gt;Step E: 日末保存&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;save_ending_inventory(date)&lt;br&gt;save_daily_state(date) → CSV 快照&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#82b366;fontSize=11;shadow=1;align=left;spacingLeft=10;" vertex="1" parent="flow_col">
          <mxGeometry x="100" y="835" width="320" height="55" as="geometry" />
        </mxCell>

        <!-- Decision: 下一天? -->
        <mxCell id="f_nextday" value="还有&lt;br&gt;下一天?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;shadow=1;" vertex="1" parent="flow_col">
          <mxGeometry x="190" y="920" width="120" height="70" as="geometry" />
        </mxCell>

        <!-- Final -->
        <mxCell id="f_final" value="&lt;b&gt;最终处理&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;InventoryBalanceChecker · 库存平衡校验&lt;br&gt;SummaryReportGenerator · 汇总报告生成&lt;br&gt;(DB 模式: 写入 module*_output_* 表)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;shadow=1;align=left;spacingLeft=10;" vertex="1" parent="flow_col">
          <mxGeometry x="100" y="1025" width="320" height="68" as="geometry" />
        </mxCell>

        <!-- End -->
        <mxCell id="f_end" value="&lt;b&gt;仿真完成&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1;shadow=1;" vertex="1" parent="flow_col">
          <mxGeometry x="170" y="1125" width="160" height="50" as="geometry" />
        </mxCell>

        <!-- 流程箭头 -->
        <mxCell id="fe1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;" edge="1" parent="flow_col" source="f_start" target="f_dayloop">
          <mxGeometry relative="1" as="geometry" />
