  <diagram id="m1-order-subflow" name="订单生成子流程">
    <mxGraphModel dx="1300" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="o_title" value="M1 订单生成子流程（自上而下）" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="540" height="40" as="geometry" />
        </mxCell>
        <mxCell id="o_start" value="generate_daily_orders()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="500" y="90" width="260" height="70" as="geometry" />
        </mxCell>
        <mxCell id="o_decision" value="是否为订单日？&lt;br&gt;OrderCalendar.date == sim_date" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="540" y="210" width="180" height="130" as="geometry" />
        </mxCell>
        <mxCell id="o_empty" value="否&lt;br&gt;返回空 orders_df&lt;br&gt;current_forecast 不变" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="850" y="230" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="o_avg" value="_compute_ml_avg_demand()&lt;br&gt;未来 7 天窗口平均需求&lt;br&gt;空窗口时回退 1 天" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="480" y="390" width="300" height="90" as="geometry" />
        </mxCell>
        <mxCell id="o_ao" value="_generate_ao_orders()&lt;br&gt;AO percent * 平均需求&lt;br&gt;按 error_std_percent 扰动&lt;br&gt;订单日期 = sim_date + advance_days" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="210" y="550" width="310" height="120" as="geometry" />
        </mxCell>
        <mxCell id="o_normal" value="_generate_normal_orders()&lt;br&gt;(1 - AO percent) * 平均需求&lt;br&gt;按 normal error 扰动&lt;br&gt;订单日期 = sim_date" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="730" y="550" width="310" height="120" as="geometry" />
        </mxCell>
        <mxCell id="o_join" value="concat AO + normal" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="520" y="720" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="o_agg" value="_aggregate_orders()&lt;br&gt;按 date/material/location/demand_type/simulation_date/advance_days 聚合" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="430" y="820" width="400" height="70" as="geometry" />
        </mxCell>
        <mxCell id="oe1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#6c8ebf" edge="1" parent="1" source="o_start" target="o_decision"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="oe2" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#666666" edge="1" parent="1" source="o_decision" target="o_empty"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="oe3" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#6c8ebf" edge="1" parent="1" source="o_decision" target="o_avg"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="oe4" value="ml_avg_demand" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#6c8ebf" edge="1" parent="1" source="o_avg" target="o_ao"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="oe5" value="ml_avg_demand" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#6c8ebf" edge="1" parent="1" source="o_avg" target="o_normal"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="oe6" value="AO orders" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#d6b656" edge="1" parent="1" source="o_ao" target="o_join"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="oe7" value="normal orders" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#d6b656" edge="1" parent="1" source="o_normal" target="o_join"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="oe8" value="orders_df" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#d6b656" edge="1" parent="1" source="o_join" target="o_agg"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="m1-shipment-sdl-subflow" name="发货与供需日志子流程">
    <mxGraphModel dx="1500" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="s_title" value="M1 发货与 SupplyDemandLog 子流程（分两条独立支路）" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="740" height="40" as="geometry" />
        </mxCell>
        <mxCell id="s_orders" value="all_orders_df&lt;br&gt;累计订单池" style="shape=cylinder3d;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="70" y="110" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="s_filter" value="generate_shipment_with_inventory_check()&lt;br&gt;筛选 date == simulation_date 的到期订单" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="420" y="100" width="330" height="100" as="geometry" />
        </mxCell>
        <mxCell id="s_inv" value="_build_available_inventory_from_orchestrator()&lt;br&gt;beginning inventory + production GR + delivery GR&lt;br&gt;_to_ml_granularity()" style="shape=cylinder3d;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="70" y="260" width="310" height="120" as="geometry" />
        </mxCell>
        <mxCell id="s_calc" value="simulate_shipment_for_single_day()&lt;br&gt;qty_ordered 按 ML 聚合&lt;br&gt;qty_avail 来自库存字典&lt;br&gt;shipped = min(qty_ordered, qty_avail)&lt;br&gt;cut = qty_ordered - shipped" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="840" y="100" width="340" height="140" as="geometry" />
        </mxCell>
        <mxCell id="s_out" value="ShipmentLog / CutLog&lt;br&gt;ShipmentLog 增加 demand_type=customer 与 order_id" style="shape=cylinder3d;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="1240" y="120" width="220" height="100" as="geometry" />
        </mxCell>

        <mxCell id="s_supply_in" value="daily_for_supply + today_orders_df" style="shape=cylinder3d;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12" vertex="1" parent="1">
