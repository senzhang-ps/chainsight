        <mxCell id="orchestrator_read" value="Orchestrator 可用库存读取&lt;br&gt;beginning inventory&lt;br&gt;production GR&lt;br&gt;delivery GR" style="shape=cylinder3d;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12" vertex="1" parent="lane_outputs">
          <mxGeometry x="60" y="70" width="240" height="100" as="geometry" />
        </mxCell>
        <mxCell id="ship" value="_generate_shipments()&lt;br&gt;generate_shipment_with_inventory_check()&lt;br&gt;shipped = min(order, available)&lt;br&gt;cut = order - shipped" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12" vertex="1" parent="lane_outputs">
