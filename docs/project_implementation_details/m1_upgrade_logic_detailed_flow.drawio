  <diagram id="m1-order-date-allocation" name="下单日分配与需求日">
    <mxGraphModel dx="1268" dy="611" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="950" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p3_title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=22;fontStyle=1" value="&lt;b&gt;split_weekly_orders_to_daily()：本周拆分 + 当日筛选 + assign 需求日（一函数完成）&lt;/b&gt;" vertex="1">
          <mxGeometry height="40" width="900" x="40" y="20" as="geometry" />
        </mxCell>
        <mxCell id="p3_weekly" parent="1" style="shape=cylinder3d;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12" value="&lt;b&gt;weekly_orders_internal&lt;/b&gt;&lt;br&gt;week / demand_type / quantity&lt;br&gt;advance_days" vertex="1">
          <mxGeometry height="110" width="250" x="60" y="105" as="geometry" />
        </mxCell>
        <mxCell id="p3_dates" parent="1" style="shape=cylinder3d;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12" value="&lt;b&gt;order_dates&lt;/b&gt;&lt;br&gt;本周 OrderCalendar 有效下单日&lt;br&gt;例如 Mon / Wed / Fri" vertex="1">
          <mxGeometry height="110" width="250" x="60" y="285" as="geometry" />
        </mxCell>
        <mxCell id="p3_allocate" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12" value="&lt;b&gt;split_weekly_orders_to_daily() 内：&lt;/b&gt;&lt;br&gt;&lt;b&gt;_split_integer_quantity_by_days()&lt;/b&gt;&lt;br&gt;按 valid_order_dates 平均分配&lt;br&gt;base = qty // len(valid_order_dates)&lt;br&gt;余数按 order_date 升序补齐" vertex="1">
          <mxGeometry height="145" width="350" x="390" y="140" as="geometry" />
        </mxCell>
        <mxCell id="p3_allocated" parent="1" style="shape=cylinder3d;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12" value="&lt;b&gt;allocated_orders_internal&lt;/b&gt;&lt;br&gt;order_date / demand_type / quantity&lt;br&gt;advance_days" vertex="1">
          <mxGeometry height="115" width="260" x="810" y="155" as="geometry" />
        </mxCell>
        <mxCell id="p3_filter" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12" value="&lt;b&gt;split_weekly_orders_to_daily() 内：&lt;/b&gt;&lt;br&gt;&lt;b&gt;split_idx = valid_order_dates.index(simulation_date)&lt;/b&gt;&lt;br&gt;每日只取 order_date == simulation_date 的份额&lt;br&gt;注意：此处筛选键是 order_date，不是 demand_date" vertex="1">
          <mxGeometry height="105" width="290" x="1170" y="160" as="geometry" />
        </mxCell>
        <mxCell id="p3_assign" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12" value="&lt;b&gt;split_weekly_orders_to_daily() 内：&lt;/b&gt;&lt;br&gt;&lt;b&gt;demand_date = simulation_date + advance_days&lt;/b&gt;&lt;br&gt;normal: advance_days=0 → demand_date = order_date&lt;br&gt;AO: advance_days&gt;0 → demand_date = order_date + advance_days&lt;br&gt;OrderCalendar 不决定 demand_date" vertex="1">
          <mxGeometry height="135" width="330" x="1150" y="310" as="geometry" />
        </mxCell>
        <mxCell id="p3_orderlog" parent="1" style="shape=cylinder3d;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12" value="&lt;b&gt;today_orders_df / OrderLog 行&lt;/b&gt;&lt;br&gt;date = demand_date（即 require_date）&lt;br&gt;simulation_date = order_date&lt;br&gt;material / location / demand_type / quantity / advance_days" vertex="1">
          <mxGeometry height="120" width="330" x="1150" y="490" as="geometry" />
        </mxCell>
        <mxCell id="p3_note" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12" value="&lt;b&gt;关键语义（与 refactor 代码一致）&lt;/b&gt;&lt;br&gt;order_date：下单日，来自 OrderCalendar&lt;br&gt;demand_date（require_date）：需求/到期日，写入 OrderLog.date&lt;br&gt;simulation_date：当天仿真日 = 当天生成订单的 order_date&lt;br&gt;变量在代码中为 demand_date；OrderLog 列名为 date" vertex="1">
          <mxGeometry height="140" width="650" x="390" y="490" as="geometry" />
        </mxCell>
        <mxCell id="p3_merge" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12" value="&lt;b&gt;_merge_with_history()&lt;/b&gt;&lt;br&gt;AO 若 require_date 在未来，会留在累计订单池&lt;br&gt;到 require_date 当天再发货" vertex="1">
          <mxGeometry height="115" width="330" x="390" y="705" as="geometry" />
        </mxCell>
        <mxCell id="p3_ship" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12" value="&lt;b&gt;_generate_shipments()&lt;/b&gt;&lt;br&gt;按 OrderLog.date == simulation_date&lt;br&gt;处理到期订单" vertex="1">
          <mxGeometry height="95" width="270" x="820" y="715" as="geometry" />
        </mxCell>
        <mxCell id="p3_output" parent="1" style="shape=cylinder3d;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12" value="&lt;b&gt;输出 schema 不变&lt;/b&gt;&lt;br&gt;OrderLog.date 仍是下游需求 / 到期日&lt;br&gt;不默认写出 order_date / source_week" vertex="1">
          <mxGeometry height="110" width="330" x="1140" y="707.5" as="geometry" />
        </mxCell>
        <mxCell id="p3_e1" edge="1" parent="1" source="p3_weekly" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#d6b656;orthogonalLoop=1;jettySize=auto" target="p3_allocate" value="">
