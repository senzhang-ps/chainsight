{
  "@context": {
    "cs": "http://chainsight.example.org/ontology#",
    "csmeta": "https://chainsight.ai/meta/",
    "skos": "http://www.w3.org/2004/02/skos/core#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "owl": "http://www.w3.org/2002/07/owl#",

    "label": "rdfs:label",
    "comment": "rdfs:comment",
    "altLabel": { "@id": "skos:altLabel", "@container": "@set" },
    "subClassOf": { "@id": "rdfs:subClassOf", "@type": "@id" },
    "domain": { "@id": "rdfs:domain", "@type": "@id" },
    "range": { "@id": "rdfs:range", "@type": "@id" },

    "Network": "cs:Network",
    "Product": "cs:Product",
    "Resource": "cs:Resource",
    "Inventory": "cs:Inventory",
    "Plan": "cs:Plan",
    "Parameter": "cs:Parameter",
    "Metric": "cs:Metric",

    "Location": "cs:Location",
    "TransportationLane": "cs:TransportationLane",
    "Material": "cs:Material",
    "MaterialLocation": "cs:MaterialLocation",
    "MaterialLocationLine": "cs:MaterialLocationLine",
    "ProductionLine": "cs:ProductionLine",
    "SpaceCapacity": "cs:SpaceCapacity",
    "Vehicle": "cs:Vehicle",
    "TruckCapacity": "cs:TruckCapacity",
    "InitialInventory": "cs:InitialInventory",
    "UnrestrictedInventory": "cs:UnrestrictedInventory",
    "InTransit": "cs:InTransit",
    "ProductionGR": "cs:ProductionGR",
    "DeliveryGR": "cs:DeliveryGR",
    "SafetyStock": "cs:SafetyStock",
    "DemandForecast": "cs:DemandForecast",
    "CustomerOrder": "cs:CustomerOrder",
    "ProductionPlan": "cs:ProductionPlan",
    "OpenDeployment": "cs:OpenDeployment",
    "DeploymentPlan": "cs:DeploymentPlan",
    "CustomerShipment": "cs:CustomerShipment",
    "IntersiteDelivery": "cs:IntersiteDelivery",
    "TunableParameter": "cs:TunableParameter",
    "CostMetric": "cs:CostMetric",
    "CashMetric": "cs:CashMetric",
    "ServiceMetric": "cs:ServiceMetric",

    "sending": { "@id": "cs:sending", "@type": "@id" },
    "receiving": { "@id": "cs:receiving", "@type": "@id" },
    "material": { "@id": "cs:material", "@type": "@id" },
    "location": { "@id": "cs:location", "@type": "@id" },
    "source_type": "cs:source_type",
    "source_config": "cs:source_config",
    "feasibility_horizon": "cs:feasibility_horizon",
    "param_name": "cs:param_name",
    "module": "cs:module",
    "controls": "cs:controls",
    "param_type": "cs:param_type",
    "metric_name": "cs:metric_name",
    "computation_source": "cs:computation_source",
    "unit": "cs:unit",
    "influences": { "@id": "cs:influences", "@type": "@id" },
    "constrains": { "@id": "cs:constrains", "@type": "@id" },
    "measuredBy": { "@id": "cs:measuredBy", "@type": "@id" },
    "triggers": { "@id": "cs:triggers", "@type": "@id" },
    "drivesNetDemand": { "@id": "cs:drivesNetDemand", "@type": "@id" },
    "fulfills": { "@id": "cs:fulfills", "@type": "@id" },
    "forecasts": { "@id": "cs:forecasts", "@type": "@id" },
    "drivesDeployment": { "@id": "cs:drivesDeployment", "@type": "@id" },
    "createsOpenDeployment": { "@id": "cs:createsOpenDeployment", "@type": "@id" },
    "executesDelivery": { "@id": "cs:executesDelivery", "@type": "@id" },
    "produces": { "@id": "cs:produces", "@type": "@id" },
    "transitsAs": { "@id": "cs:transitsAs", "@type": "@id" },
    "receivedAs": { "@id": "cs:receivedAs", "@type": "@id" },
    "constrainsProduction": { "@id": "cs:constrainsProduction", "@type": "@id" },
    "constrainsStorage": { "@id": "cs:constrainsStorage", "@type": "@id" },
    "constrainsLogistics": { "@id": "cs:constrainsLogistics", "@type": "@id" },
    "configuresProduction": { "@id": "cs:configuresProduction", "@type": "@id" },
    "product_tier": "cs:product_tier",

    "OperationalEntity": "csmeta:OperationalEntity",
    "Agent": "csmeta:Agent",
    "Skill": "csmeta:Skill",
    "Tool": "csmeta:Tool",
    "coversClass": { "@id": "csmeta:coversClass", "@type": "@id" },
    "usedByAgent": { "@id": "csmeta:usedByAgent", "@type": "@id" },
    "hasSkill": { "@id": "csmeta:hasSkill", "@type": "@id" },
    "operatesOn": { "@id": "csmeta:operatesOn", "@type": "@id" },
    "skillFile": "csmeta:skillFile",
    "configFile": "csmeta:configFile",
    "derivedFrom": "csmeta:derivedFrom",
    "status": "csmeta:status",
    "knowledgeDomain": "csmeta:knowledgeDomain"
  }
}
