<mxfile host="Electron" agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) draw.io/29.3.0 Chrome/140.0.7339.249 Electron/38.7.2 Safari/537.36" version="29.3.0" pages="3">
  <diagram id="m1-upgrade-main" name="M1 重构主链路">
    <mxGraphModel dx="2120" dy="920" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1980" pageHeight="1050" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p1_title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=22;fontStyle=1" value="&lt;b&gt;M1 重构后总流程：weekly CoV 生成周订单总量，再按 OrderCalendar 分配下单日&lt;/b&gt;" vertex="1">
          <mxGeometry height="40" width="1420" x="40" y="20" as="geometry" />
        </mxCell>
        <mxCell id="p1_legend" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=left;spacing=8" value="蓝色：函数处理节点&lt;br&gt;绿色：输入 / 配置 / 状态读取&lt;br&gt;橙色：中间或最终数据对象&lt;br&gt;红色：下游消费 / 兼容边界" vertex="1">
          <mxGeometry height="110" width="330" x="1470" as="geometry" />
        </mxCell>
        <mxCell id="p1_lane_cfg" parent="1" style="swimlane;html=1;startSize=30;horizontal=1;rounded=0;fillColor=#eef7ee;strokeColor=#82b366;fontStyle=1" value="&lt;b&gt;配置校验与 forecast 视图准备&lt;/b&gt;" vertex="1">
          <mxGeometry height="230" width="1860" x="40" y="110" as="geometry" />
        </mxCell>
        <mxCell id="p1_cfg" parent="p1_lane_cfg" style="shape=cylinder3d;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12" value="&lt;b&gt;M1 配置输入&lt;/b&gt;&lt;br&gt;DemandForecast / ForecastError(COV) / OrderCalendar&lt;br&gt;AOConfig / DPSConfig / SupplyChoiceConfig" vertex="1">
          <mxGeometry height="105" width="290" x="20" y="65" as="geometry" />
        </mxCell>
        <mxCell id="p1_entry" parent="p1_lane_cfg" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1" value="&lt;b&gt;run_daily_order_generation()&lt;/b&gt;&lt;br&gt;入口签名保持不变" vertex="1">
          <mxGeometry height="80" width="235" x="360" y="77.5" as="geometry" />
        </mxCell>
        <mxCell id="p1_validate" parent="p1_lane_cfg" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12" value="&lt;b&gt;_validate_config()&lt;/b&gt;&lt;br&gt;必填表检查 / 日期转换&lt;br&gt;负需求裁零 / 标识符标准化" vertex="1">
          <mxGeometry height="105" width="270" x="675" y="65" as="geometry" />
        </mxCell>
        <mxCell id="p1_prepare" parent="p1_lane_cfg" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12" value="&lt;b&gt;_prepare_forecasts()&lt;/b&gt;&lt;br&gt;weekly_for_orders：DPS 后保留周级 forecast&lt;br&gt;daily_for_consumption：订单层兼容消耗基线&lt;br&gt;daily_for_supply：DPS + SupplyChoice 后供 SDL 使用" vertex="1">
          <mxGeometry height="135" width="335" x="1010" y="50" as="geometry" />
        </mxCell>
        <mxCell id="p1_views" parent="p1_lane_cfg" style="shape=cylinder3d;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12" value="&lt;b&gt;三类 forecast 视图&lt;/b&gt;&lt;br&gt;weekly_for_orders&lt;br&gt;daily_for_consumption&lt;br&gt;daily_for_supply" vertex="1">
          <mxGeometry height="105" width="220" x="1460" y="65" as="geometry" />
        </mxCell>
        <mxCell id="p1_lane_order" parent="1" style="swimlane;html=1;startSize=30;horizontal=1;rounded=0;fillColor=#f7fbff;strokeColor=#6c8ebf;fontStyle=1" value="&lt;b&gt;订单生成：总量与结构分别抽样，归一后按本周下单日分配&lt;/b&gt;" vertex="1">
          <mxGeometry height="320" width="1860" x="30" y="380" as="geometry" />
        </mxCell>
        <mxCell id="p1_order_dates" parent="p1_lane_order" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12" value="&lt;b&gt;Step 1（嵌入 split_weekly_orders_to_daily）&lt;/b&gt;&lt;br&gt;&lt;b&gt;_normalized_calendar_dates() + _build_week_start_map()&lt;/b&gt;&lt;br&gt;基于 OrderCalendar 判断本周有几天下单日&lt;br&gt;valid_order_dates = [d for d in calendar if week_start≤d&lt;week_end]" vertex="1">
          <mxGeometry height="110" width="250" x="50" y="65" as="geometry" />
        </mxCell>
        <mxCell id="p1_weekly_qty" parent="p1_lane_order" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;verticalAlign=top;spacing=6" value="&lt;b&gt;Step 2 generate_weekly_orders()（5 步内部时序，详见 page 2）&lt;/b&gt;&lt;br&gt;1. _build_weekly_ml_demand: 按 ml/week 聚合&lt;br&gt;2. _split_weekly_demand_by_ao_means: 用 AOConfig 拆 AO/normal 均值&lt;br&gt;3. _generate_weekly_total_orders: total CoV 抽周总量&lt;br&gt;4. _generate_weekly_component_orders: AO/normal CoV 抽临时数量&lt;br&gt;5. _reconcile_weekly_component_orders_to_total: 归一回总量" vertex="1">
          <mxGeometry height="120" width="280" x="360" y="60" as="geometry" />
        </mxCell>
        <mxCell id="p1_split_type" parent="p1_lane_order" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12" value="&lt;b&gt;Step 3（generate_weekly_orders 内部）&lt;/b&gt;&lt;br&gt;&lt;b&gt;_reconcile_weekly_component_orders_to_total()&lt;/b&gt;&lt;br&gt;将 _generate_weekly_component_orders() 的临时 AO/normal&lt;br&gt;归一回 _generate_weekly_total_orders() 的周总量" vertex="1">
          <mxGeometry height="105" width="260" x="705" y="65" as="geometry" />
        </mxCell>
        <mxCell id="p1_allocate" parent="p1_lane_order" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12" value="&lt;b&gt;Step 4（split_weekly_orders_to_daily 内部）&lt;/b&gt;&lt;br&gt;&lt;b&gt;_split_integer_quantity_by_days()&lt;/b&gt;&lt;br&gt;按本周有效下单日整数拆分&lt;br&gt;base = qty // len(valid_order_dates)&lt;br&gt;余数按 order_date 升序补齐" vertex="1">
          <mxGeometry height="140" width="300" x="1020" y="45" as="geometry" />
        </mxCell>
        <mxCell id="p1_allocated" parent="p1_lane_order" style="shape=cylinder3d;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12" value="&lt;b&gt;allocated_orders_internal&lt;/b&gt;&lt;br&gt;week / order_type / order_date&lt;br&gt;quantity / advance_days" vertex="1">
          <mxGeometry height="105" width="190" x="1450" y="62.5" as="geometry" />
        </mxCell>
        <mxCell id="p1_filter" parent="p1_lane_order" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12" value="&lt;b&gt;Step 5a&lt;/b&gt;&lt;br&gt;&lt;b&gt;split_weekly_orders_to_daily()&lt;/b&gt;&lt;br&gt;每日仿真只取 split_idx = valid_order_dates.index(simulation_date)&lt;br&gt;split_qty = split_quantities[split_idx]" vertex="1">
          <mxGeometry height="80" width="250" x="1010" y="225" as="geometry" />
        </mxCell>
        <mxCell id="p1_assign" parent="p1_lane_order" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12" value="&lt;b&gt;Step 5b（split_weekly_orders_to_daily 内部）&lt;/b&gt;&lt;br&gt;&lt;b&gt;demand_date = simulation_date + advance_days&lt;/b&gt;&lt;br&gt;normal: advance_days=0 → demand_date = order_date&lt;br&gt;AO: advance_days&gt;0 → demand_date = order_date + advance_days" vertex="1">
          <mxGeometry height="95" width="300" x="1310" y="215" as="geometry" />
        </mxCell>
        <mxCell id="p1_today" parent="p1_lane_order" style="shape=cylinder3d;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12" value="&lt;b&gt;Step 5c&lt;/b&gt;&lt;br&gt;&lt;b&gt;today_orders_df&lt;/b&gt;&lt;br&gt;OrderLog.date = require_date&lt;br&gt;simulation_date = order_date" vertex="1">
          <mxGeometry height="85" width="190" x="1640" y="220" as="geometry" />
        </mxCell>
        <mxCell id="p1_lane_output" parent="1" style="swimlane;html=1;startSize=30;horizontal=1;rounded=0;fillColor=#fff9ef;strokeColor=#d6b656;fontStyle=1" value="&lt;b&gt;历史合并、发货、供需日志、输出兼容&lt;/b&gt;" vertex="1">
          <mxGeometry height="280" width="1860" x="40" y="740" as="geometry" />
        </mxCell>
        <mxCell id="p1_history" parent="p1_lane_output" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12" value="&lt;b&gt;历史订单来源&lt;/b&gt;&lt;br&gt;DB: previous_orders_df&lt;br&gt;文件: load_previous_orders()" vertex="1">
          <mxGeometry height="95" width="235" x="20" y="80" as="geometry" />
        </mxCell>
        <mxCell id="p1_merge" parent="p1_lane_output" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12" value="&lt;b&gt;_merge_with_history()&lt;/b&gt;&lt;br&gt;合并历史订单与 today_orders_df&lt;br&gt;保留未来 require_date 订单" vertex="1">
          <mxGeometry height="105" width="285" x="350" y="75" as="geometry" />
        </mxCell>
        <mxCell id="p1_all" parent="p1_lane_output" style="shape=cylinder3d;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12" value="&lt;b&gt;all_orders_df&lt;/b&gt;&lt;br&gt;累计日级订单池&lt;br&gt;写入 OrderLog" vertex="1">
          <mxGeometry height="90" width="210" x="690" y="82.5" as="geometry" />
        </mxCell>
        <mxCell id="p1_ship" parent="p1_lane_output" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12" value="&lt;b&gt;_generate_shipments()&lt;/b&gt;&lt;br&gt;筛选 OrderLog.date == simulation_date&lt;br&gt;使用 Orchestrator 可用库存" vertex="1">
          <mxGeometry height="105" width="285" x="980" y="50" as="geometry" />
        </mxCell>
        <mxCell id="p1_sdl" parent="p1_lane_output" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12" value="&lt;b&gt;_apply_orders_consumption()&lt;/b&gt;&lt;br&gt;daily_for_supply + today_orders_df&lt;br&gt;生成 SupplyDemandLog 未来窗口" vertex="1">
          <mxGeometry height="90" width="285" x="980" y="170" as="geometry" />
        </mxCell>
        <mxCell id="p1_output" parent="p1_lane_output" style="shape=cylinder3d;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12" value="&lt;b&gt;生产输出 schema 不变&lt;/b&gt;&lt;br&gt;OrderLog / ShipmentLog / CutLog&lt;br&gt;SupplyDemandLog / Summary" vertex="1">
          <mxGeometry height="105" width="245" x="1340" y="82.5" as="geometry" />
        </mxCell>
        <mxCell id="p1_downstream" parent="p1_lane_output" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12" value="&lt;b&gt;下游透明&lt;/b&gt;&lt;br&gt;M3 / M5 / Summary / DB writer&lt;br&gt;不需要理解 week 或周级中间表" vertex="1">
          <mxGeometry height="105" width="190" x="1630" y="82.5" as="geometry" />
        </mxCell>
