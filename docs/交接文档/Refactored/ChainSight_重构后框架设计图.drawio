        <mxCell id="out_col" value="&lt;b&gt;模块输出 (每日 Excel/CSV)&lt;/b&gt;" style="swimlane;startSize=24;fillColor=#f5f5f5;strokeColor=#666666;rounded=1;fontSize=11;fontStyle=1;swimlaneLine=0;collapsible=0;" vertex="1" parent="1">
