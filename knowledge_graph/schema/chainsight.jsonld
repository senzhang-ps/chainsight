    },

    {
      "@id": "cs:ProductionQuota",
      "@type": "owl:Class",
      "subClassOf": "cs:Resource",
      "label": "ProductionQuota",
      "altLabel": ["配额分配", "quota", "production quota"],
      "comment": "Production quota arrangement — allocates production volume of a material across multiple lines or plants based on defined ratios.",
      "cs:properties": {
        "material": {"type": "cs:Material", "required": true},
        "location": {"type": "cs:Location", "required": true},
