      "subClassOf": "cs:Metric",
      "label": "OutOfStock",
      "altLabel": ["断货", "OOS", "即将断货", "to-be-OOS"],
      "comment": "Projected out-of-stock status — materials expected to run out at a location within a forecast horizon. An early warning metric.",
      "cs:properties": {
        "material": {"type": "cs:Material", "required": true},
        "location": {"type": "cs:Location", "required": true},
        "date": {"type": "xsd:date", "description": "Projected OOS date"}
      },
      "cs:source_table": ["cdl_ps_hana_prd.sl.ps_psc_to_be_oos"],
      "cs:source_type": "derived"
    },

    {
      "@id": "cs:DemandPriority",
      "@type": "owl:Class",
      "subClassOf": "cs:Parameter",
      "label": "DemandPriority",
      "altLabel": ["需求优先级", "demand priority", "fulfillment priority"],
      "comment": "Demand fulfillment priority policy — assigns a priority rank to each demand element, controlling the order in which competing demands are allocated scarce inventory during M5 deployment.",
      "cs:properties": {
        "demand_element": {"type": "xsd:string", "description": "Demand element / channel identifier", "required": true},
        "priority": {"type": "xsd:integer", "description": "Priority rank (lower number = higher priority)", "required": true, "min_value": 1}
      },
      "cs:source_config": "Global_DemandPriority",
      "cs:source_type": "config_input"
    },

    {
      "@id": "cs:ForecastError",
      "@type": "owl:Class",
      "subClassOf": "cs:Parameter",
      "label": "ForecastError",
      "altLabel": ["预测误差", "forecast error", "FC error"],
      "comment": "Forecast error parameter — standard deviation (as a percent of demand) of forecast error per material-location and order type. Drives stochastic demand-noise injection in M1. The scalar knob is also exposed as cs:param_error_std_percent.",
      "cs:properties": {
        "material": {"type": "cs:Material", "required": true},
        "location": {"type": "cs:Location", "required": true},
        "order_type": {"type": "xsd:string", "description": "Order type the error applies to (e.g. normal / AO)", "required": true},
        "error_std_percent": {"type": "xsd:float", "description": "Forecast error standard deviation as a percent of demand (≥0)", "required": true, "min_value": 0}
      },
      "cs:source_config": "M1_ForecastError",
      "cs:source_type": "config_input"
    },

    {
      "@id": "cs:ProductionReliability",
      "@type": "owl:Class",
      "subClassOf": "cs:Parameter",
      "label": "ProductionReliability",
      "altLabel": ["生产可靠性", "production reliability", "yield factor"],
      "comment": "Production reliability factor per plant line — the fraction of capacity-constrained planned quantity actually produced. M4 multiplies con_planned_qty by pr to derive produced_qty.",
      "cs:properties": {
        "location": {"type": "cs:Location", "description": "Plant location", "required": true},
        "line": {"type": "xsd:string", "description": "Production line identifier", "required": true},
        "pr": {"type": "xsd:float", "description": "Production reliability ratio (0–1)", "required": true, "min_value": 0}
      },
      "cs:source_config": "M4_ProductionReliability",
      "cs:source_type": "config_input"
    },

    {
      "@id": "cs:TruckReleaseCon",
      "@type": "owl:Class",
      "subClassOf": "cs:Parameter",
      "label": "TruckReleaseCon",
      "altLabel": ["卡车放行条件", "truck release condition", "release threshold"],
      "comment": "Truck release condition per lane and truck type — fill-rate thresholds (WFR/VFR) and minimum delivery quantity (MDQ) that must be met before M6 releases a truck. The scalar WFR/VFR knobs are also exposed as cs:param_wfr / cs:param_vfr.",
      "cs:properties": {
        "sending": {"type": "cs:Location", "required": true},
        "receiving": {"type": "cs:Location", "required": true},
        "truck_type": {"type": "xsd:string", "description": "Truck type (references Vehicle.truck_type)", "required": true},
        "optimal_type": {"type": "xsd:string", "description": "Preferred/optimal truck type for this lane", "required": false},
        "WFR": {"type": "xsd:float", "description": "Weight fill-rate threshold to trigger release (0–1)", "required": false, "min_value": 0},
        "VFR": {"type": "xsd:float", "description": "Volume fill-rate threshold to trigger release (0–1)", "required": false, "min_value": 0},
        "MDQ": {"type": "xsd:float", "description": "Minimum delivery quantity required to release a truck (≥0)", "required": false, "min_value": 0}
      },
      "cs:source_config": "M6_TruckReleaseCon",
      "cs:source_type": "config_input"
    },

    {
      "@id": "cs:DeliveryDelay",
      "@type": "owl:Class",
      "subClassOf": "cs:Parameter",
      "label": "DeliveryDelay",
      "altLabel": ["交付延迟", "delivery delay", "delay distribution"],
      "comment": "Stochastic delivery-delay distribution per lane — probability of incurring a given number of extra transit-delay days. M6 samples from this to perturb planned delivery dates.",
      "cs:properties": {
        "date": {"type": "xsd:date", "description": "Effective date of the distribution", "required": false},
        "sending": {"type": "cs:Location", "required": true},
        "receiving": {"type": "cs:Location", "required": true},
        "delay_days": {"type": "xsd:integer", "description": "Number of extra delay days (≥0)", "required": true, "min_value": 0},
        "probability": {"type": "xsd:float", "description": "Probability of this delay outcome (0–1)", "required": true, "min_value": 0}
      },
      "cs:source_config": "M6_DeliveryDelayDistribution",
      "cs:source_type": "config_input"
    },

    {
      "@id": "cs:MDQBypass",
      "@type": "owl:Class",
      "subClassOf": "cs:Parameter",
      "label": "MDQBypass",
      "altLabel": ["MDQ绕过规则", "MDQ bypass", "bypass rule"],
      "comment": "Minimum-delivery-quantity bypass rule — conditional logic that lets specific lane / truck-type / demand-element combinations skip the MDQ truck-release constraint. Each rule_id is referenced by M6 bypass-rule-hit logs (module6_output_bypassrulehitlog.rule_id).",
      "cs:properties": {
        "sending": {"type": "cs:Location", "required": true},
        "receiving": {"type": "cs:Location", "required": true},
        "truck_type": {"type": "xsd:string", "description": "Truck type the rule applies to", "required": false},
        "demand_element": {"type": "xsd:string", "description": "Demand element the rule applies to", "required": false},
        "condition_logic": {"type": "xsd:string", "description": "Boolean condition expression defining when the bypass applies", "required": true},
        "rule_id": {"type": "xsd:string", "description": "Unique rule identifier (referenced by module6_output_bypassrulehitlog.rule_id)", "required": true}
      },
      "cs:source_config": "M6_MDQBypassRules",
      "cs:source_type": "config_input"
    },

    {
      "@id": "cs:TunableParameter",
      "@type": "owl:Class",
      "subClassOf": "cs:Parameter",
      "label": "TunableParameter",
      "altLabel": ["param", "parameter", "参数"],
      "comment": "A tunable business parameter — primary target for what-if scenario analysis. Each instance represents one adjustable input in the simulation config.",
      "cs:properties": {
        "param_name": {
          "type": "xsd:string",
          "description": "Parameter name matching config table field",
          "required": true
        },
        "module": {
          "type": "xsd:string",
          "description": "Simulation module (M1–M6 / Orchestrator)",
          "required": true
        },
        "controls": {
          "type": "xsd:string",
          "description": "What this parameter controls",
          "required": true
        },
        "param_type": {
          "type": "xsd:string",
          "description": "Data type (float, integer, enum, string)",
          "required": true
        }
      },
      "cs:source_type": "config_input"
    },

    {
      "@id": "cs:CostMetric",
      "@type": "owl:Class",
      "subClassOf": "cs:Metric",
      "label": "CostMetric",
      "comment": "Cost-related KPIs — measures of operational cost efficiency.",
      "cs:source_type": "derived"
    },
    {
      "@id": "cs:CashMetric",
      "@type": "owl:Class",
      "subClassOf": "cs:Metric",
      "label": "CashMetric",
      "comment": "Cash-related KPIs — measures of working capital and inventory investment.",
      "cs:source_type": "derived"
    },
    {
      "@id": "cs:ServiceMetric",
      "@type": "owl:Class",
      "subClassOf": "cs:Metric",
      "label": "ServiceMetric",
      "comment": "Service-related KPIs — measures of customer fulfillment and delivery performance.",
      "cs:source_type": "derived"
    }
  ]
}
