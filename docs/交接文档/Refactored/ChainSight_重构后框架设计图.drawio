<mxCell id="po3" value="&lt;font color=&#x27;#558B2F&#x27; style=&#x27;font-size:10px&#x27;&gt;&lt;b&gt;③ process_module5_deployment(deployment_df)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&#x27;font-size:8px&#x27;&gt;创建 open_deployment → 扣减发送方库存&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;fontSize=9;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;overflow=hidden;arcSize=4;" vertex="1" parent="po"><mxGeometry x="15" y="135" width="515" height="42" as="geometry"/></mxCell>
<mxCell id="po4" value="&lt;font color=&#x27;#827717&#x27; style=&#x27;font-size:10px&#x27;&gt;&lt;b&gt;④ process_module6_delivery(delivery_df)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&#x27;font-size:8px&#x27;&gt;关闭 open_deployment → 增加接收方库存&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;fontSize=9;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;overflow=hidden;arcSize=4;" vertex="1" parent="po"><mxGeometry x="15" y="185" width="515" height="42" as="geometry"/></mxCell>
<mxCell id="po5" value="&lt;font color=&#x27;#BF360C&#x27; style=&#x27;font-size:10px&#x27;&gt;&lt;b&gt;⑤ cleanup_past_due_open_deployments()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&#x27;font-size:8px&#x27;&gt;清理过期调拨 (grace_days)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;fontSize=9;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;overflow=hidden;arcSize=4;" vertex="1" parent="po"><mxGeometry x="15" y="235" width="515" height="42" as="geometry"/></mxCell>
<mxCell id="dfl1" value="" style="rounded=0;fillColor=none;strokeColor=#2E7D32;strokeWidth=2;dashed=0;" vertex="1" parent="1"><mxGeometry x="1350" y="940" width="30" height="2" as="geometry"/></mxCell>
<mxCell id="dfl1t" value="&lt;font style=&#x27;font-size:9px&#x27;&gt;━━ 数据输出 (写入)&lt;/font&gt;" style="text;html=1;fontSize=9;fontStyle=0;align=left;fillColor=none;strokeColor=none;fontColor=#333;" vertex="1" parent="1"><mxGeometry x="1385" y="930" width="180" height="20" as="geometry"/></mxCell>
