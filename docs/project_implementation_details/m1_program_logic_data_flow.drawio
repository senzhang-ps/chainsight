  <diagram id="m1-order-subflow" name="订单生成子流程">
    <mxGraphModel dx="1268" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="1120" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="o_title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1" value="M1 订单生成子流程（周级订单优先，日级路径兼容）" vertex="1">
          <mxGeometry height="40" width="540" x="40" y="20" as="geometry" />
        </mxCell>
        <mxCell id="o_start" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1" value="generate_daily_orders()" vertex="1">
          <mxGeometry height="70" width="260" x="500" y="90" as="geometry" />
        </mxCell>
        <mxCell id="o_decision" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12" value="_uses_weekly_order_generation()?&lt;br&gt;forecast 含 week 且不含 date" vertex="1">
          <mxGeometry height="130" width="180" x="540" y="210" as="geometry" />
        </mxCell>
        <mxCell id="o_empty" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12" value="否：日级兼容路径&lt;br&gt;判断 OrderCalendar.date == sim_date&lt;br&gt;计算 7 天平均需求&lt;br&gt;生成 AO / normal" vertex="1">
          <mxGeometry height="90" width="220" x="850" y="230" as="geometry" />
        </mxCell>
        <mxCell id="o_avg" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12" value="_generate_daily_orders_from_weekly()&lt;br&gt;准备 consumed_forecast&lt;br&gt;调用周级订单生成与拆日" vertex="1">
          <mxGeometry height="90" width="300" x="480" y="390" as="geometry" />
        </mxCell>
        <mxCell id="o_ao" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;verticalAlign=top;spacing=6" value="&lt;b&gt;generate_weekly_orders()（5 步内部时序）&lt;/b&gt;&lt;br&gt;1. _build_weekly_ml_demand：按 material/location/week 聚合周需求&lt;br&gt;2. _split_weekly_demand_by_ao_means：用 AOConfig 拆 AO/normal 周级均值&lt;br&gt;3. _generate_weekly_total_orders：total/weekly CoV 抽周总量&lt;br&gt;4. _generate_weekly_component_orders：AO/normal CoV 抽临时数量&lt;br&gt;5. _reconcile_weekly_component_orders_to_total：临时按比例归一回总量&lt;br&gt;归一后的周级数量 = 后续拆日的守恒基线" vertex="1">
          <mxGeometry height="180" width="380" x="180" y="510" as="geometry" />
        </mxCell>
        <mxCell id="o_normal" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12" value="split_weekly_orders_to_daily()&lt;br&gt;按本周 OrderCalendar 有效下单日拆分&lt;br&gt;仅返回 simulation_date 当天份额&lt;br&gt;最后 assign require_date" vertex="1">
          <mxGeometry height="120" width="310" x="730" y="550" as="geometry" />
        </mxCell>
        <mxCell id="o_join" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12" value="日级 orders_df&lt;br&gt;normal: date = simulation_date&lt;br&gt;AO: date = simulation_date + advance_days" vertex="1">
          <mxGeometry height="60" width="220" x="520" y="720" as="geometry" />
        </mxCell>
        <mxCell id="o_agg" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12" value="_aggregate_orders()&lt;br&gt;按 date/material/location/demand_type/simulation_date/advance_days 聚合" vertex="1">
          <mxGeometry height="70" width="400" x="430" y="820" as="geometry" />
        </mxCell>
        <mxCell id="o_consume" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12" value="consume_orders()&lt;br&gt;使用 daily_for_consumption 返回 consumed_forecast&lt;br&gt;AO 优先，再 normal" vertex="1">
          <mxGeometry height="80" width="400" x="430" y="930" as="geometry" />
        </mxCell>
        <mxCell id="o_return" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12" value="返回 (orders_df, consumed_forecast)&lt;br&gt;run_daily_order_generation() 使用 orders_df&lt;br&gt;SupplyDemandLog 另用 daily_for_supply 消耗" vertex="1">
          <mxGeometry height="65" width="360" x="450" y="1040" as="geometry" />
        </mxCell>
        <mxCell id="oe1" edge="1" parent="1" source="o_start" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#6c8ebf" target="o_decision" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="oe2" edge="1" parent="1" source="o_decision" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#666666" target="o_empty" value="否">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="oe3" edge="1" parent="1" source="o_decision" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#6c8ebf" target="o_avg" value="是">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="oe4" edge="1" parent="1" source="o_avg" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#6c8ebf" target="o_ao" value="weekly path">
          <mxGeometry relative="1" as="geometry" />
