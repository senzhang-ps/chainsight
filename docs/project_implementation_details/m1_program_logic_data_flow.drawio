        <mxCell id="ship" parent="lane_outputs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12" value="_generate_shipments()&lt;br&gt;generate_shipment_with_inventory_check()&lt;br&gt;shipped = min(order, available)&lt;br&gt;cut = order - shipped" vertex="1">
          <mxGeometry height="115" width="310" x="380" y="70" as="geometry" />
