        <mxCell id="o_m1" value="&lt;font style=&quot;font-size:10px&quot;&gt;📄 module1_output_YYYYMMDD.xlsx&lt;br&gt;OrderLog | ShipmentLog | CutLog&lt;br&gt;SupplyDemandLog | Summary&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="out_col">
