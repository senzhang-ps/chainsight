        "location": {"type": "cs:Location", "required": true},
        "date": {"type": "xsd:date", "description": "Planned order date", "required": true},
        "quantity": {"type": "xsd:float", "description": "Planned quantity"},
        "order_type": {"type": "xsd:string", "description": "Production / procurement / transfer"}
      },
      "cs:source_table": ["cdl_ps_hana_prd.sl.ps_psc_planned_order"],
      "cs:source_type": "config_input"
    },

    {
      "@id": "cs:PurchaseRequisition",
      "@type": "owl:Class",
      "subClassOf": "cs:Plan",
      "label": "PurchaseRequisition",
      "altLabel": ["采购需求", "PR", "purchase req"],
