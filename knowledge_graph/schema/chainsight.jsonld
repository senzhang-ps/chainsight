    },

    {
      "@id": "cs:AllocationPool",
      "@type": "owl:Class",
      "subClassOf": "cs:Inventory",
      "label": "AllocationPool",
      "altLabel": ["分配池", "allocation pool", "库存分配池"],
      "comment": "Inventory allocation pool — pre-allocated inventory buckets by material and location. A subset of unrestricted inventory earmarked for specific demand channels.",
      "cs:properties": {
        "material": {"type": "cs:Material", "required": true},
        "location": {"type": "cs:Location", "required": true},
        "date": {"type": "xsd:date", "description": "Snapshot date"},
        "quantity": {"type": "xsd:float", "description": "Pool quantity in demand units"}
      },
      "cs:source_table": ["cdl_ps_hana_prd.sl.ps_psc_allocation_pool_inventory", "cdl_ps_hana_prd.ds.ps_psc_allocation_pool_inventory_snapshot_daily_fact"],
      "cs:source_type": "config_input"
    },

    {
      "@id": "cs:Batch",
      "@type": "owl:Class",
      "subClassOf": "cs:Inventory",
      "label": "Batch",
      "altLabel": ["批次", "batch", "lot"],
      "comment": "Batch-level inventory — stock tracked by production batch with shelf life and quality status. Used for FIFO/FEFO analysis and expiry management.",
      "cs:properties": {
        "material": {"type": "cs:Material", "required": true},
        "location": {"type": "cs:Location", "required": true},
        "batch_id": {"type": "xsd:string", "description": "Batch/lot identifier", "required": true},
        "quantity": {"type": "xsd:float", "description": "Batch stock quantity"},
        "production_date": {"type": "xsd:date", "description": "Manufacturing date"}
      },
      "cs:source_table": ["cdl_ps_hana_prd.dwd.tb_sc_wh_batches_daily_fact"],
      "cs:source_type": "config_input"
    },

    {
      "@id": "cs:Allocation",
      "@type": "owl:Class",
      "subClassOf": "cs:Plan",
      "label": "Allocation",
      "altLabel": ["配额", "sales allocation", "销售配额"],
      "comment": "Sales allocation quota — limits how much of a material can be sold through a specific channel/customer within a time period. Distinct from AllocationPool (inventory bucket).",
      "cs:properties": {
        "material": {"type": "cs:Material", "required": true},
        "location": {"type": "cs:Location", "required": true},
        "date": {"type": "xsd:date", "description": "Allocation period"},
        "allocated_qty": {"type": "xsd:float", "description": "Allocated quantity"}
      },
      "cs:source_table": ["cdl_ps_hana_prd.ods.sales_hub_allocation_inventory"],
      "cs:source_type": "config_input"
    },

    {
      "@id": "cs:DependentRequirement",
