        <mxCell id="save" parent="lane_outputs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12" value="_save_output() / _build_summary_df()&lt;br&gt;Excel 输出或 DB 内存返回&lt;br&gt;OrderLog / ShipmentLog / CutLog&lt;br&gt;SupplyDemandLog / Summary" vertex="1">
          <mxGeometry height="115" width="300" x="1040" y="120" as="geometry" />
