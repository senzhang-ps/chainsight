{
  "@context": "../../schema/context.jsonld",
  "@graph": [
    {"@id": "cs:metric_fill_rate",                    "@type": "cs:ServiceMetric", "label": "fill_rate",                    "cs:metric_name": "fill_rate",                    "cs:computation_source": "M1 shipment_qty / order_qty",                              "cs:unit": "%",            "comment": "Percentage of demand fulfilled from stock"},
    {"@id": "cs:metric_dfc",                          "@type": "cs:CashMetric",    "label": "dfc",                          "cs:metric_name": "dfc",                          "cs:computation_source": "Orchestrator inventory / forward demand",                  "cs:unit": "days",         "comment": "Days Forward Coverage — how many days current inventory can cover future demand"},
    {"@id": "cs:metric_production_capacity_utilization","@type": "cs:CostMetric",  "label": "production_capacity_utilization","cs:metric_name": "production_capacity_utilization","cs:computation_source": "M4 con_planned_qty / line_capacity",                       "cs:unit": "%",            "comment": "Production line usage rate"},
    {"@id": "cs:metric_changeover_frequency",         "@type": "cs:CostMetric",    "label": "changeover_frequency",         "cs:metric_name": "changeover_frequency",         "cs:computation_source": "M4 changeover log count",                                  "cs:unit": "count",        "comment": "Number of production switches"},
    {"@id": "cs:metric_on_time_delivery_rate",        "@type": "cs:ServiceMetric", "label": "on_time_delivery_rate",        "cs:metric_name": "on_time_delivery_rate",        "cs:computation_source": "M6 on_time_deliveries / total_deliveries",                 "cs:unit": "%",            "comment": "Delivery performance"},
    {"@id": "cs:metric_truck_fill_rate",              "@type": "cs:CostMetric",    "label": "truck_fill_rate",              "cs:metric_name": "truck_fill_rate",              "cs:computation_source": "M6 loaded_weight / truck_capacity (WFR/VFR)",              "cs:unit": "%",            "comment": "Vehicle loading efficiency"},
    {"@id": "cs:metric_total_inventory_holding_cost", "@type": "cs:CashMetric",    "label": "total_inventory_holding_cost", "cs:metric_name": "total_inventory_holding_cost", "cs:computation_source": "Orchestrator inventory * holding cost rate",               "cs:unit": "currency",     "comment": "Cash impact of inventory"},
    {"@id": "cs:metric_space_capacity_requirement",   "@type": "cs:CostMetric",    "label": "space_capacity_requirement",   "cs:metric_name": "space_capacity_requirement",   "cs:computation_source": "Orchestrator max(daily_inventory) per location per month", "cs:unit": "demand_units", "comment": "Peak storage capacity per location — drives rental cost"},
    {"@id": "cs:metric_rental_cost",                  "@type": "cs:CostMetric",    "label": "rental_cost",                  "cs:metric_name": "rental_cost",                  "cs:computation_source": "space_capacity_requirement * rental_rate",                 "cs:unit": "currency",     "comment": "Warehousing cost from storage capacity needs"},
    {"@id": "cs:metric_handling_cost",               "@type": "cs:CostMetric",    "label": "handling_cost",               "cs:metric_name": "handling_cost",               "cs:computation_source": "dc_handling_touches * handling_cost_rate",                 "cs:unit": "currency",     "comment": "DC inbound and outbound handling cost per unit shipped through DC (receiving, put-away, pick, despatch)"},
    {"@id": "cs:metric_transportation_cost",         "@type": "cs:CostMetric",    "label": "transportation_cost",         "cs:metric_name": "transportation_cost",         "cs:computation_source": "sum of freight cost across F→DC, DC→Customer, F→Customer DPS lanes", "cs:unit": "currency",     "comment": "Total freight cost — net DPS impact depends on lane distances and load factors, must be validated via simulation"},
    {"@id": "cs:metric_ctd",                          "@type": "cs:ServiceMetric", "label": "ctd",                          "cs:metric_name": "ctd",                          "cs:computation_source": "effective_capacity / demand_volume (simple ratio for MVP)",           "cs:unit": "ratio",       "comment": "Capacity to Demand ratio — production capacity sufficiency indicator. Values close to 1.0 indicate tight capacity; serves as feasibility gate for what-if scenarios (e.g. Baby Care A888 target ≤ 1.15)"},
    {"@id": "cs:metric_changeover_cost",              "@type": "cs:CostMetric",    "label": "changeover_cost",              "cs:metric_name": "changeover_cost",              "cs:computation_source": "changeover_frequency * unit_changeover_cost (single aggregate for MVP)", "cs:unit": "currency",   "comment": "Manufacturing changeover cost (MOE component) — total cost of production line switches"}
  ]
}
