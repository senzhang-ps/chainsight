<mxfile host="app.diagrams.net" modified="2026-05-07T11:20:00.000Z" agent="Codex" version="24.7.17" type="device">
  <diagram id="m1-clean-main" name="M1 主链路-清晰版">
    <mxGraphModel dx="1700" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="M1 Demand Planning 主链路（左到右，避免交叉连线）" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="760" height="40" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="蓝色：函数处理节点&lt;br&gt;绿色：输入/状态读取&lt;br&gt;橙色：中间或最终数据对象&lt;br&gt;红色：状态更新/下游消费" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=left;spacing=8" vertex="1" parent="1">
          <mxGeometry x="1340" y="20" width="300" height="100" as="geometry" />
        </mxCell>

        <mxCell id="lane_cfg" value="配置与预测准备" style="swimlane;html=1;startSize=30;horizontal=1;rounded=0;fillColor=#eef7ee;strokeColor=#82b366;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="1580" height="210" as="geometry" />
        </mxCell>
        <mxCell id="cfg" value="M1 配置输入&lt;br&gt;DemandForecast / ForecastError / OrderCalendar / AOConfig / DPSConfig / SupplyChoiceConfig" style="shape=cylinder3d;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12" vertex="1" parent="lane_cfg">
          <mxGeometry x="30" y="70" width="260" height="100" as="geometry" />
        </mxCell>
        <mxCell id="entry" value="run_daily_order_generation()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1" vertex="1" parent="lane_cfg">
          <mxGeometry x="350" y="80" width="230" height="70" as="geometry" />
        </mxCell>
        <mxCell id="validate" value="_validate_config()&lt;br&gt;必填表检查 / 日期转换 / 负需求裁零 / 标识符标准化" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12" vertex="1" parent="lane_cfg">
          <mxGeometry x="650" y="70" width="260" height="90" as="geometry" />
        </mxCell>
        <mxCell id="prepare" value="_prepare_forecasts()&lt;br&gt;DPS 拆分 / SupplyChoice 调整 / 周转日度预测" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12" vertex="1" parent="lane_cfg">
