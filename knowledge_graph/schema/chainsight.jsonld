      "subClassOf": "cs:Plan",
      "label": "DependentRequirement",
      "altLabel": ["相关需求", "dependent req", "BOM explosion"],
      "comment": "Dependent requirement generated by MRP BOM explosion — component-level demand derived from finished goods production plans.",
      "cs:properties": {
        "material": {"type": "cs:Material", "required": true},
        "location": {"type": "cs:Location", "required": true},
        "date": {"type": "xsd:date", "description": "Requirement date", "required": true},
        "quantity": {"type": "xsd:float", "description": "Required quantity"}
      },
      "cs:source_table": ["cdl_ps_hana_prd.sl.ps_psc_dependent_requirement"],
      "cs:source_type": "config_input"
    },

    {
      "@id": "cs:DailyForecast",
      "@type": "owl:Class",
      "subClassOf": "cs:Plan",
      "label": "DailyForecast",
      "altLabel": ["日度预测", "independent requirement", "PIR", "独立需求"],
      "comment": "Daily-level forecast / planned independent requirement. More granular than weekly DemandForecast. Used for short-term analysis and production scheduling validation.",
      "cs:properties": {
        "material": {"type": "cs:Material", "required": true},
        "location": {"type": "cs:Location", "required": true},
        "date": {"type": "xsd:date", "description": "Forecast date", "required": true},
        "quantity": {"type": "xsd:float", "description": "Forecasted daily quantity"}
      },
      "cs:source_table": ["cdl_ps_hana_prd.dwd.tb_sc_prod_independent_req_data_fact"],
      "cs:source_type": "config_input"
    },

    {
      "@id": "cs:PlannedOrder",
      "@type": "owl:Class",
      "subClassOf": "cs:Plan",
      "label": "PlannedOrder",
      "altLabel": ["计划订单", "planned order", "MRP output"],
