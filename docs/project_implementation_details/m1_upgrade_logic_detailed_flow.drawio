  <diagram id="m1-weekly-order-generation" name="周级订单生成 5 步时序">
    <mxGraphModel dx="1500" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p2_title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1" value="&lt;b&gt;generate_weekly_orders() 5 步内部时序：聚合 → AO 均值拆分 → total 抽样 → component 抽样 → 归一&lt;/b&gt;" vertex="1">
          <mxGeometry height="40" width="1500" x="40" y="20" as="geometry" />
        </mxCell>

        <!-- Inputs -->
        <mxCell id="p2_forecast" parent="1" style="shape=cylinder3d;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12" value="&lt;b&gt;DemandForecast&lt;/b&gt;&lt;br&gt;material / location / week&lt;br&gt;weekly demand mean" vertex="1">
          <mxGeometry height="100" width="220" x="40" y="100" as="geometry" />
        </mxCell>
        <mxCell id="p2_ao_config" parent="1" style="shape=cylinder3d;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12" value="&lt;b&gt;AOConfig&lt;/b&gt;&lt;br&gt;ao_percent / advance_days&lt;br&gt;按 material/location/order_type" vertex="1">
          <mxGeometry height="100" width="220" x="40" y="370" as="geometry" />
        </mxCell>
        <mxCell id="p2_error" parent="1" style="shape=cylinder3d;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12" value="&lt;b&gt;ForecastError(CoV)&lt;/b&gt;&lt;br&gt;total/weekly CoV → Step 3&lt;br&gt;AO/normal CoV → Step 4" vertex="1">
          <mxGeometry height="110" width="220" x="40" y="640" as="geometry" />
        </mxCell>

        <!-- Step 1 -->
        <mxCell id="p2_s1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacing=6" value="&lt;b&gt;Step 1  _build_weekly_ml_demand()&lt;/b&gt;&lt;br&gt;按 material / location / week 聚合周需求&lt;br&gt;稳定排序保证随机可复现" vertex="1">
          <mxGeometry height="100" width="320" x="340" y="100" as="geometry" />
        </mxCell>
        <mxCell id="p2_d1" parent="1" style="shape=cylinder3d;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12" value="&lt;b&gt;weekly_demand&lt;/b&gt;&lt;br&gt;聚合后的 ml/week 周需求" vertex="1">
          <mxGeometry height="80" width="220" x="740" y="110" as="geometry" />
        </mxCell>

        <!-- Step 2 (AO mean split) -->
        <mxCell id="p2_s2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacing=6" value="&lt;b&gt;Step 2  _split_weekly_demand_by_ao_means()&lt;/b&gt;&lt;br&gt;AO 均值 = weekly_demand × ao_percent&lt;br&gt;normal 均值 = weekly_demand × (1 − Σ ao_percent)&lt;br&gt;裁剪为非负整数；按 demand_type 拆为两行" vertex="1">
          <mxGeometry height="120" width="370" x="1010" y="100" as="geometry" />
        </mxCell>
        <mxCell id="p2_d2" parent="1" style="shape=cylinder3d;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12" value="&lt;b&gt;weekly_order_means&lt;/b&gt;&lt;br&gt;ml/week × demand_type&lt;br&gt;AO baseline / normal baseline" vertex="1">
          <mxGeometry height="100" width="220" x="1080" y="280" as="geometry" />
        </mxCell>

        <!-- Step 3 (total sampling) -->
        <mxCell id="p2_s3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacing=6" value="&lt;b&gt;Step 3  _generate_weekly_total_orders()&lt;/b&gt;&lt;br&gt;基于 weekly_demand × total/weekly CoV&lt;br&gt;按截断正态分布抽样整周订单总量&lt;br&gt;quantity 裁剪为非负整数" vertex="1">
          <mxGeometry height="120" width="320" x="340" y="450" as="geometry" />
        </mxCell>
        <mxCell id="p2_d3" parent="1" style="shape=cylinder3d;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12" value="&lt;b&gt;weekly_total_orders&lt;/b&gt;&lt;br&gt;ml/week 周总量&lt;br&gt;来自 total CoV 抽样" vertex="1">
          <mxGeometry height="100" width="220" x="740" y="460" as="geometry" />
        </mxCell>

        <!-- Step 4 (component sampling) -->
        <mxCell id="p2_s4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacing=6" value="&lt;b&gt;Step 4  _generate_weekly_component_orders()&lt;/b&gt;&lt;br&gt;基于 weekly_order_means × AO/normal CoV&lt;br&gt;每个 demand_type 独立按截断正态抽样&lt;br&gt;得到临时 AO / normal 周级数量（未归一）" vertex="1">
          <mxGeometry height="120" width="370" x="1010" y="450" as="geometry" />
        </mxCell>
        <mxCell id="p2_d4" parent="1" style="shape=cylinder3d;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12" value="&lt;b&gt;provisional_orders&lt;/b&gt;&lt;br&gt;ml/week × demand_type&lt;br&gt;临时 AO / normal 数量（未归一）" vertex="1">
          <mxGeometry height="100" width="240" x="1075" y="630" as="geometry" />
        </mxCell>

        <!-- Step 5 (reconcile) -->
        <mxCell id="p2_s5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacing=6" value="&lt;b&gt;Step 5  _reconcile_weekly_component_orders_to_total()&lt;/b&gt;&lt;br&gt;输入：provisional_orders + weekly_total_orders&lt;br&gt;按 ml/week 内 AO/normal 比例缩放到 weekly_total&lt;br&gt;余数按稳定顺序补齐为整数&lt;br&gt;归一后 sum(AO + normal) = weekly_total_orders" vertex="1">
          <mxGeometry height="140" width="430" x="500" y="800" as="geometry" />
        </mxCell>
        <mxCell id="p2_out" parent="1" style="shape=cylinder3d;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12" value="&lt;b&gt;weekly_orders_internal&lt;/b&gt;&lt;br&gt;week / material / location&lt;br&gt;demand_type: AO / normal&lt;br&gt;reconciled quantity / advance_days" vertex="1">
          <mxGeometry height="120" width="280" x="1080" y="810" as="geometry" />
        </mxCell>
        <mxCell id="p2_invariant" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=left;spacing=6" value="&lt;b&gt;周级守恒（拆日基线）&lt;/b&gt;&lt;br&gt;sum(AO + normal quantity) ≡ weekly_total_orders&lt;br&gt;归一后的周级数量 = split_weekly_orders_to_daily 的守恒基线&lt;br&gt;后续按下单日整数拆分仍保留此守恒" vertex="1">
          <mxGeometry height="120" width="430" x="60" y="810" as="geometry" />
        </mxCell>

        <!-- Edges: inputs to steps -->
        <mxCell id="p2_e1" edge="1" parent="1" source="p2_forecast" target="p2_s1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#82b366;orthogonalLoop=1;jettySize=auto" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2_e2" edge="1" parent="1" source="p2_s1" target="p2_d1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#d6b656;orthogonalLoop=1;jettySize=auto" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2_e3" edge="1" parent="1" source="p2_d1" target="p2_s2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#6c8ebf;orthogonalLoop=1;jettySize=auto" value="weekly_demand">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2_e4" edge="1" parent="1" source="p2_ao_config" target="p2_s2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#82b366;orthogonalLoop=1;jettySize=auto" value="ao_percent">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="280" y="420" />
              <mxPoint x="990" y="420" />
              <mxPoint x="990" y="220" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="p2_e5" edge="1" parent="1" source="p2_s2" target="p2_d2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#d6b656;orthogonalLoop=1;jettySize=auto" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="p2_e6" edge="1" parent="1" source="p2_d1" target="p2_s3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#6c8ebf;orthogonalLoop=1;jettySize=auto" value="weekly_demand">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="850" y="350" />
              <mxPoint x="500" y="350" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="p2_e7" edge="1" parent="1" source="p2_error" target="p2_s3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#82b366;orthogonalLoop=1;jettySize=auto" value="total CoV">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2_e8" edge="1" parent="1" source="p2_s3" target="p2_d3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#d6b656;orthogonalLoop=1;jettySize=auto" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="p2_e9" edge="1" parent="1" source="p2_d2" target="p2_s4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#6c8ebf;orthogonalLoop=1;jettySize=auto" value="weekly_order_means">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2_e10" edge="1" parent="1" source="p2_error" target="p2_s4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#82b366;dashed=1;orthogonalLoop=1;jettySize=auto" value="AO/normal CoV">
          <mxGeometry relative="1" as="geometry">
