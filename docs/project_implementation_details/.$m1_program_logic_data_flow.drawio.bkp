        <mxCell id="s_sdl_out" value="SupplyDemandLog&lt;br&gt;date / material / location / quantity / demand_element" style="shape=cylinder3d;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12" vertex="1" parent="1">
