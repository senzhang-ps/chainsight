{
    "version": "0.2.0",
    "configurations": [
        
        {
            "name": "Run BC_S5 Simulation (2025-10-06)",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/run.py",
            "python": "${workspaceFolder}/.venv/Scripts/python.exe",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            },
            "subProcess": true,
            "console": "integratedTerminal",
            "args": [
                "--config", "test_files/BC_S5.xlsx",
                "--start-date", "2025-10-06",
                "--end-date", "2025-10-10"
            ],
            "justMyCode": false
        },
        {
            "name": "Python: Debug Current File",
            "type": "python",
            "request": "launch",
            "program": "${file}",
            "python": "${workspaceFolder}/.venv/Scripts/python.exe",
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "Resume BC_S5 Simulation",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/run.py",
            "python": "${workspaceFolder}/.venv/Scripts/python.exe",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            },
            "subProcess": true,
            "console": "integratedTerminal",
            "args": [
                "--config", "test_files/BC_S5.xlsx",
                "--end-date", "2025-10-10",
                "--resume"
            ],
            "justMyCode": false
        }
    ]
}