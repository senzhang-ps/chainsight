        <mxCell id="sdl_process" value="_apply_orders_consumption()&lt;br&gt;generate_supply_demand_log_for_integration()&lt;br&gt;AO 优先，再 normal&lt;br&gt;offset: 0,-1,-2,+1,+2,+3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12" vertex="1" parent="lane_outputs">
          <mxGeometry x="380" y="200" width="310" height="95" as="geometry" />
        </mxCell>
        <mxCell id="sdl_out" value="SupplyDemandLog&lt;br&gt;未来窗口 forecast demand" style="shape=cylinder3d;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12" vertex="1" parent="lane_outputs">
          <mxGeometry x="770" y="210" width="190" height="75" as="geometry" />
        </mxCell>
        <mxCell id="save" value="_save_output() / _build_summary_df()&lt;br&gt;Excel 输出或 DB 内存返回&lt;br&gt;OrderLog / ShipmentLog / CutLog / SupplyDemandLog / Summary" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12" vertex="1" parent="lane_outputs">
          <mxGeometry x="1040" y="120" width="300" height="115" as="geometry" />
        </mxCell>
        <mxCell id="downstream" value="下游与状态更新&lt;br&gt;process_module1_shipments() 扣减库存&lt;br&gt;M5 消费 OrderLog / SupplyDemandLog / ShipmentLog&lt;br&gt;M3 / Summary / DB writer 消费 M1 输出" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12" vertex="1" parent="lane_outputs">
          <mxGeometry x="1410" y="105" width="150" height="150" as="geometry" />
