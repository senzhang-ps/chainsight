        </mxCell>
        <mxCell id="daily_views" value="daily_for_orders&lt;br&gt;daily_for_supply" style="shape=cylinder3d;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12" vertex="1" parent="lane_cfg">
          <mxGeometry x="1320" y="80" width="210" height="70" as="geometry" />
        </mxCell>

        <mxCell id="lane_order" value="订单生成与历史订单合并" style="swimlane;html=1;startSize=30;horizontal=1;rounded=0;fillColor=#f7fbff;strokeColor=#6c8ebf;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="340" width="1580" height="220" as="geometry" />
        </mxCell>
        <mxCell id="gen_order" value="generate_daily_orders()&lt;br&gt;订单日判断 / 7天均值 / AO订单 / normal订单 / 聚合" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12" vertex="1" parent="lane_order">
          <mxGeometry x="60" y="80" width="300" height="95" as="geometry" />
        </mxCell>
        <mxCell id="today_orders" value="today_orders_df&lt;br&gt;当日新订单" style="shape=cylinder3d;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12" vertex="1" parent="lane_order">
          <mxGeometry x="440" y="90" width="190" height="70" as="geometry" />
        </mxCell>
        <mxCell id="history" value="历史订单来源&lt;br&gt;DB: previous_orders_df&lt;br&gt;文件: load_previous_orders()" style="shape=cylinder3d;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12" vertex="1" parent="lane_order">
          <mxGeometry x="710" y="80" width="220" height="95" as="geometry" />
        </mxCell>
        <mxCell id="merge" value="_merge_with_history()&lt;br&gt;过滤未来订单 / 去重 / 合并 / 标准化" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12" vertex="1" parent="lane_order">
          <mxGeometry x="1010" y="80" width="260" height="95" as="geometry" />
        </mxCell>
        <mxCell id="all_orders" value="all_orders_df / orders_df&lt;br&gt;累计订单池" style="shape=cylinder3d;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12" vertex="1" parent="lane_order">
          <mxGeometry x="1360" y="90" width="190" height="70" as="geometry" />
        </mxCell>

        <mxCell id="lane_outputs" value="发货、供需日志、输出与状态更新" style="swimlane;html=1;startSize=30;horizontal=1;rounded=0;fillColor=#fff9ef;strokeColor=#d6b656;fontStyle=1" vertex="1" parent="1">
