        <mxCell id="orchestrator_read" parent="lane_outputs" style="shape=cylinder3d;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12" value="Orchestrator 可用库存读取&lt;br&gt;beginning inventory&lt;br&gt;production GR&lt;br&gt;delivery GR" vertex="1">
          <mxGeometry height="100" width="240" x="40" y="77.5" as="geometry" />
