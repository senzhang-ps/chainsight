        <mxCell id="downstream" parent="lane_outputs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12" value="下游与状态更新&lt;br&gt;process_module1_shipments() 扣减库存&lt;br&gt;M5 / M3 / Summary / DB writer&lt;br&gt;不需要读取周级中间表" vertex="1">
